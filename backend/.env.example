# TimeSense AI Configuration
PROCESS_FPS=5
YOLO_MODEL=yolov8n.pt
TRACKER_TYPE=bytetrack.yaml
CONFIDENCE_THRESHOLD=0.35
STATIONARY_DISPLACEMENT_THRESH=30.0
UNATTENDED_TIME_THRESH=4.0
LOITER_TIME_THRESH=8.0

# Optional LLM / Vision-Language Model
# System operates 100% deterministically without an API key!
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_PROVIDER=gemini
